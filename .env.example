# Үүнийг .env нэрээр хуулж, утгуудаа бичнэ:  cp .env.example .env
# Сервер (EC2)-ийн нийтийн IP. Өөрийн компьютер дээр туршихдаа: localhost
EC2_IP=localhost
# Сангийн нууц үг (санамсаргүй урт утга)
POSTGRES_PASSWORD=CHANGE_ME
# Токены нууц түлхүүр (32+ тэмдэгт):  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
