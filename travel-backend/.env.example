# Өгөгдлийн сангийн холбоос (жинхэнэ утгыг зөвхөн .env файлд бичнэ)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/travel.02

# Frontend-ийн хаягууд, таслалаар тусгаарлана
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ML загварын зам (Prompt 6-д ашиглана)
MODEL_PATH=demand_model.joblib

# Токен гарын үсэг зурах нууц түлхүүр (урт, санамсаргүй утга бичнэ)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Токен хэдэн минут хүчинтэй байх
JWT_EXPIRE_MINUTES=60
